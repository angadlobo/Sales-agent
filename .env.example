# ── AI provider ─────────────────────────────────────────────────────
# The "brain" of the agent. Default: Anthropic Claude.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Or run on any OpenAI-compatible provider instead of Anthropic:
#   LLM_PROVIDER=github      GitHub Models — key: GITHUB_TOKEN (PAT with models:read)
#   LLM_PROVIDER=openrouter  OpenRouter    — key: OPENROUTER_API_KEY
#   LLM_PROVIDER=openai      OpenAI        — key: OPENAI_API_KEY
#   LLM_PROVIDER=custom      anything else (Groq, Together, Ollama, …)
#                            — set LLM_BASE_URL + LLM_API_KEY
# LLM_API_KEY also works for every provider and wins over the specific vars.
#
# NOTE: live web search for lead discovery works on anthropic (built-in) and
# openrouter (web plugin). github / openai / custom run without web access,
# so discovery falls back to the model's own knowledge.
#LLM_PROVIDER=anthropic
#LLM_API_KEY=
#LLM_BASE_URL=
#GITHUB_TOKEN=github_pat_...
#OPENROUTER_API_KEY=sk-or-...
#OPENAI_API_KEY=sk-...

# Optional: override the default models (defaults depend on LLM_PROVIDER —
# e.g. anthropic: claude-opus-4-8 / claude-haiku-4-5,
#      github: openai/gpt-4.1 / openai/gpt-4.1-mini,
#      openrouter: openai/gpt-5 / openai/gpt-5-mini)
#SALES_AGENT_MODEL=claude-opus-4-8          # reasoning / conversation
#SALES_AGENT_FAST_MODEL=claude-haiku-4-5    # cheap classification

# ── Email outreach (optional) ───────────────────────────────────────
# Standard SMTP. Example shows Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=you@yourcompany.com

# ── Inbox connector (optional — tracks email REPLIES) ──────────────
# Gmail: leave these empty — the SMTP_* app password above also works for
# IMAP and the host is derived automatically. Other providers: set explicitly.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# How often the web UI checks for replies, in seconds (0 = manual only)
INBOX_POLL_SECONDS=300

# ── Voice calls (optional — only for REAL phone calls) ─────────────
# The free browser-voice demo in the web UI needs NONE of these.
# Providers:
#   twilio      cloud, free trial credit
#   signalwire  cloud, same API, cheaper (also set SIGNALWIRE_SPACE_URL)
#   selfhosted  your own Asterisk+Whisper+Piper stack — free software, you
#               only pay a SIP trunk (~$1/mo + ~$0.01/min).
#               See docs/SELF_HOSTED_CALLS.md
VOICE_PROVIDER=twilio
VOICE_ACCOUNT_SID=AC...
VOICE_AUTH_TOKEN=...
VOICE_FROM_NUMBER=+15551234567
# Only for VOICE_PROVIDER=signalwire, e.g. yourspace.signalwire.com
SIGNALWIRE_SPACE_URL=
# Public URL where the voice webhook server is reachable (e.g. an ngrok URL)
# (twilio/signalwire only — selfhosted stays on localhost, no public URL needed)
VOICE_WEBHOOK_BASE_URL=https://your-public-host.example.com

# ── Self-hosted calls only (VOICE_PROVIDER=selfhosted) ──────────────
SELFHOSTED_VOICE_URL=http://127.0.0.1:9091
ARI_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=sales-agent
ARI_PASSWORD=change-me
ARI_ENDPOINT=PJSIP/{to}@trunk
WHISPER_MODEL=base
# PIPER_VOICE=/path/to/en_US-lessac-medium.onnx

# ── Safety ──────────────────────────────────────────────────────────
# DRY_RUN=true means NOTHING is actually sent or dialed. Flip to false
# only once you have permission to contact people and have read README's
# "Legal & ethical use" section.
DRY_RUN=true
