# ── Claude (required) ───────────────────────────────────────────────
# The "brain" of the agent. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default models
SALES_AGENT_MODEL=claude-opus-4-8          # reasoning / conversation
SALES_AGENT_FAST_MODEL=claude-haiku-4-5    # cheap classification

# ── Email outreach (optional) ───────────────────────────────────────
# Standard SMTP. Example shows Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@yourcompany.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=you@yourcompany.com

# ── Voice calls (optional — Twilio) ─────────────────────────────────
# Only needed if you enable AI phone calls.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567
# Public URL where the voice webhook server is reachable (e.g. an ngrok URL)
VOICE_WEBHOOK_BASE_URL=https://your-public-host.example.com

# ── Safety ──────────────────────────────────────────────────────────
# DRY_RUN=true means NOTHING is actually sent or dialed. Flip to false
# only once you have permission to contact people and have read README's
# "Legal & ethical use" section.
DRY_RUN=true
